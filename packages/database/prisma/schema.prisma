// Playmorrow database schema
// Docs: https://pris.ly/d/prisma-schema
//
// V1 tables: users, studios, studio_members, games, game_media, devlogs,
// roadmap_items, press_kits, follows, comments, reactions, tags, game_tags,
// platform_links, moderation_reports.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────────────────
// Enums
// ──────────────────────────────────────────────────────────────────────────

/// Global account role. Studio-scoped roles live on StudioMember.
enum UserRole {
  PLAYER
  PUBLISHER
  MODERATOR
  ADMIN
}

/// A member's role within a single studio.
enum StudioRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

enum StudioInvitationStatus {
  PENDING
  REQUESTED
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum GameStatus {
  CONCEPT
  PRE_ALPHA
  IN_DEVELOPMENT
  ALPHA
  BETA
  EARLY_ACCESS
  RELEASED
  CANCELLED
  ON_HOLD
}

enum MediaType {
  SCREENSHOT
  TRAILER
  VIDEO
  LOGO
  BANNER
  IMAGE
}

enum RoadmapStatus {
  PLANNED
  IN_PROGRESS
  DONE
  CANCELLED
}

enum ReactionType {
  LIKE
  LOVE
  HYPE
  INSIGHTFUL
}

/// Registration intent — not a permission level.
enum AccountType {
  PLAYER
  STUDIO
}

enum FollowTargetType {
  STUDIO
  GAME
}

enum ReportTargetType {
  GAME
  STUDIO
  DEVLOG
  COMMENT
  USER
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum ReportReason {
  SPAM
  HARASSMENT
  HATE
  SEXUAL_CONTENT
  VIOLENCE
  COPYRIGHT
  MISLEADING
  OTHER
}

enum PlatformKind {
  STEAM
  ITCH
  EPIC
  GOG
  PLAYSTATION
  XBOX
  NINTENDO
  WEB
  ANDROID
  IOS
  DEMO
  DISCORD
  WEBSITE
  OTHER
}

// ──────────────────────────────────────────────────────────────────────────
// Identity
// ──────────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  usernameLowercase String? @unique
  displayName  String
  /// Null for OAuth-only accounts.
  passwordHash String?
  role         UserRole @default(PLAYER)
  avatarUrl    String?
  bio          String?
  location     String?
  country      String?
  level        Int      @default(0)
  xp           Int      @default(0)
  isVerified   Boolean  @default(false)
  accountType                 AccountType @default(PLAYER)
  isOnboardingCompleted       Boolean     @default(false)
  termsAcceptedAt             DateTime?
  privacyAcceptedAt           DateTime?
  communityGuidelinesAcceptedAt DateTime?
  marketingOptInAt            DateTime?
  partnerMarketingOptInAt     DateTime?
  termsVersion                String?
  privacyVersion              String?
  communityGuidelinesVersion  String?
  emailVerifiedAt             DateTime?
   emailChangeCount            Int       @default(0)
   cookiePreferences           Json?
   createdAt                   DateTime @default(now())
  updatedAt    DateTime @updatedAt

  authVersion         Int       @default(0)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  suspendedUntil      DateTime?
  shadowBanned        Boolean     @default(false)
  appealCount         Int         @default(0)
  strikeCount         Int         @default(0)
  lastStrikeAt        DateTime?

  studioMemberships     StudioMember[]
  studioInvitationsSent     StudioInvitation[] @relation("StudioInvitationsSent")
  studioInvitationsReceived StudioInvitation[] @relation("StudioInvitationsReceived")
  devlogs               Devlog[]
  comments          Comment[]
  reactions         Reaction[]
  follows           Follow[]
  reportsFiled      ModerationReport[] @relation("ReportReporter")
  reportsResolved   ModerationReport[] @relation("ReportResolver")
  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsActed    Notification[] @relation("NotificationActor")
  refreshTokens         RefreshToken[]
  sessions              Session[]
  verificationTokens      VerificationToken[]
  chatMessages          StudioChatMessage[]
  pushSubscriptions     PushSubscription[]
  emailVerificationCodes  EmailVerificationCode[]
  emailPreference         EmailPreference?
  apiKeys                 ApiKey[]
  passwordResetTokens     PasswordResetToken[]
  wishlistItems         WishlistItem[]
   auditLogs             AuditLog[]
   xpEvents              PlayerXpEvent[]
   achievements          Achievement[]
   supportTicketsAuthored   SupportTicket[] @relation("SupportTicketsAuthored")
   supportTicketsAssigned   SupportTicket[] @relation("SupportTicketsAssigned")
   supportReplies          SupportReply[]
   supportTicketHistory    SupportTicketHistory[] @relation("SupportHistoryActor")
   helpArticles            HelpArticle[]
   helpFeedback            HelpArticleFeedback[]
   reviewedVerifications   StudioVerificationRequest[] @relation("VerificationReviewer")

   @@index([role])
   @@map("users")
}

// ──────────────────────────────────────────────────────────────────────────
// Studios
// ──────────────────────────────────────────────────────────────────────────

enum StudioVerificationStatus {
  UNVERIFIED
  EMAIL_VERIFIED
  BASIC_VERIFIED
  OFFICIAL_STUDIO
  PARTNER_STUDIO
  FEATURED_STUDIO
}

model Studio {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  tagline     String?
  description String?
  logoUrl     String?
  bannerUrl   String?
  websiteUrl  String?
  location    String?
  foundedYear Int?
  isVerified      Boolean  @default(false)
  verificationStatus StudioVerificationStatus @default(UNVERIFIED)
  trustScore        Int      @default(0)
  followersCount    Int      @default(0)
  gamesCount        Int      @default(0)
  level             Int      @default(1)
  xp                Int      @default(0)

  // Company profile (Milestone 4)
  legalName        String?
  companySize      String?
  businessEmail    String?
  supportEmail     String?
  pressContact     String?
  mission          String?
  vision           String?
  discord          String?
  twitter          String?
  github           String?
  linkedin         String?
  steamUrl         String?
  epicUrl          String?
  itchUrl          String?
  engine           String?
  platforms        String?
  businessDesc     String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  members          StudioMember[]
  games            Game[]
  followers        Follow[]
  invitations      StudioInvitation[]
  auditLogs        AuditLog[]
  xpEvents         StudioXpEvent[]
  chatMessages     StudioChatMessage[]
  goals            StudioGoal[]
  achievements     StudioAchievement[]
  healthScores     StudioHealthScore[]
  weeklyReports    StudioWeeklyReport[]
  verificationReqs  StudioVerificationRequest[]
  brandKit          BrandKit?
  pressKit          StudioPressKit?

  @@map("studios")
}

model StudioVerificationRequest {
  id              String                    @id @default(cuid())
  studioId        String
  requestedLevel  StudioVerificationStatus
  status          String                    @default("PENDING") // PENDING | APPROVED | REJECTED | MORE_INFO
  documents       Json?
  notes           String?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  studio    Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  reviewedBy User?  @relation("VerificationReviewer", fields: [reviewedById], references: [id])

  @@index([studioId])
  @@index([status])
  @@map("studio_verification_requests")
}

model BrandKit {
  id          String   @id @default(cuid())
  studioId    String   @unique
  primaryLogo String?
  darkLogo    String?
  lightLogo   String?
  colors      Json?
  typography  String?
  brandRules  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@map("brand_kits")
}

model StudioPressKit {
  id            String   @id @default(cuid())
  studioId      String   @unique
  headline      String?
  factSheet     Json?
  awards        String?
  pressContacts Json?
  history       String?
  logos         Json?
  keyArt        String?
  trailerUrl    String?
  downloads     Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@map("studio_press_kits")
}

model StudioXpEvent {
  id        String   @id @default(cuid())
  studioId  String
  type      String
  amount    Int
  sourceId  String?
  createdAt DateTime @default(now())

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@index([studioId, createdAt])
  @@map("studio_xp_events")
}

model PlayerXpEvent {
  id        String   @id @default(cuid())
  userId    String
  reason    String
  amount    Int
  reference String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("player_xp_events")
}

model Achievement {
  userId        String
  achievementId String
  name          String
  unlockedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, achievementId])
  @@index([userId])
  @@map("achievements")
}

model StudioMember {
  id        String     @id @default(cuid())
  studioId  String
  userId    String
  role      StudioRole @default(MEMBER)
  /// Free-text role label shown on the studio page, e.g. "Lead Artist".
  title     String?
  joinedAt     DateTime @default(now())
  lastActiveAt DateTime?
  createdAt DateTime   @default(now())

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([studioId, userId])
  @@index([userId])
  @@map("studio_members")
}

model StudioInvitation {
  id             String                   @id @default(cuid())
  studioId       String
  invitedById    String
  email          String?
  userId         String?
  role           StudioRole
  token          String                   @unique
  status         StudioInvitationStatus   @default(PENDING)
  expiresAt      DateTime
  acceptedAt     DateTime?
  rejectedAt     DateTime?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime                 @default(now())

  studio    Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  invitedBy User   @relation("StudioInvitationsSent", fields: [invitedById], references: [id], onDelete: Cascade)
  user      User?  @relation("StudioInvitationsReceived", fields: [userId], references: [id])

  @@index([studioId, status])
  @@index([email])
  @@index([userId])
  @@map("studio_invitations")
}

model AuditLog {
  id         String   @id @default(cuid())
  studioId   String
  actorId    String
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  actor  User   @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([studioId, createdAt])
  @@map("audit_logs")
}

model StudioChatMessage {
  id        String   @id @default(cuid())
  studioId  String
  authorId  String
  message   String   @db.VarChar(2000)
  createdAt DateTime @default(now())

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([studioId, createdAt])
  @@map("studio_chat_messages")
}

model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  endpoint   String   @unique
  p256dh     String
  auth       String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// ──────────────────────────────────────────────────────────────────────────
// Games & media
// ──────────────────────────────────────────────────────────────────────────

model Game {
  id                  String     @id @default(cuid())
  slug                String     @unique
  studioId            String
  title               String
  tagline             String?
  description         String?
  status              GameStatus @default(IN_DEVELOPMENT)
  releaseDate         DateTime?
  /// Human-friendly release window when no firm date, e.g. "Q3 2026".
  expectedReleaseText String?
  priceCents          Int?
  currency            String?    @default("USD")
  isFree              Boolean    @default(false)
  coverUrl            String?
  bannerUrl           String?
  readme              String?
  trailerUrl          String?
  demoStatus          String?    @default("NO_DEMO")
  demoUrl             String?
  edition             String?
  engine              String?
  languages           String?
  genres              String?
  modes               String?
  isPublished         Boolean    @default(false)
  followersCount      Int        @default(0)
  wishlistsCount      Int        @default(0)
  commentsCount       Int        @default(0)
  viewsCount          Int        @default(0)
  featured            Boolean    @default(false)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  createdBy   String?
  updatedBy   String?
  publishedBy String?
  publishedAt DateTime?

  studio        Studio         @relation(fields: [studioId], references: [id], onDelete: Cascade)
  media         GameMedia[]
  comments      Comment[]
  devlogs       Devlog[]
  roadmapItems  RoadmapItem[]
  pressKit      PressKit?
  platformLinks PlatformLink[]
  tags          GameTag[]
  followers     Follow[]
  wishlistItems WishlistItem[]
  views         GameView[]

  @@index([studioId])
  @@index([status])
  @@index([isPublished])
  @@map("games")
}

model GameMedia {
  id           String    @id @default(cuid())
  gameId       String
  type         MediaType
  url          String
  thumbnailUrl String?
  caption      String?
  position     Int       @default(0)
  createdAt    DateTime  @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
  @@map("game_media")
}

model PlatformLink {
  id        String       @id @default(cuid())
  gameId    String
  kind      PlatformKind
  url       String
  label     String?
  position  Int          @default(0)
  createdAt DateTime     @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
  @@map("platform_links")
}

model PressKit {
  id              String   @id @default(cuid())
  gameId          String   @unique
  headline        String?
  /// Structured fact-sheet (developer, based-in, release date, platforms, ...).
  factSheet       Json?
  contactEmail    String?
  downloadUrl     String?
  isAutoGenerated Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@map("press_kits")
}

// ──────────────────────────────────────────────────────────────────────────
// Progress: devlogs & roadmap
// ──────────────────────────────────────────────────────────────────────────

enum DevlogStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
}

enum FeedEventType {
  DEVLOG_PUBLISHED
  GAME_PUBLISHED
  ROADMAP_UPDATED
  TRAILER_UPDATED
  PRESS_KIT_UPDATED
  STUDIO_CREATED
  STUDIO_VERIFIED
  ROLE_CHANGED
}

model Devlog {
  id             String        @id @default(cuid())
  gameId         String
  authorId       String
  title          String
  subtitle       String?
  slug           String
  body           String        @db.Text
  readingTimeMin Int?
  status         DevlogStatus  @default(DRAFT)
  isPublished    Boolean       @default(false)
  publishedAt    DateTime?
  scheduledFor   DateTime?
  editedAt       DateTime?
  category       String?
  tags           String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  game        Game               @relation(fields: [gameId], references: [id], onDelete: Cascade)
  author      User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments    Comment[]
  reactions   Reaction[]
  screenshots DevlogScreenshot[]
  likes       DevlogLike[]

  @@unique([gameId, slug])
  @@index([authorId])
  @@index([publishedAt])
  @@index([gameId, status, publishedAt])
  @@map("devlogs")
}

model DevlogScreenshot {
  id       String @id @default(cuid())
  devlogId String
  url      String
  order    Int    @default(0)
  caption  String?

  devlog Devlog @relation(fields: [devlogId], references: [id], onDelete: Cascade)

  @@index([devlogId])
  @@map("devlog_screenshots")
}

model DevlogLike {
  id        String   @id @default(cuid())
  devlogId  String
  userId    String
  createdAt DateTime @default(now())

  devlog Devlog @relation(fields: [devlogId], references: [id], onDelete: Cascade)

  @@unique([devlogId, userId])
  @@index([devlogId])
  @@index([userId])
  @@map("devlog_likes")
}

model FeedEvent {
  id        String        @id @default(cuid())
  type      FeedEventType
  studioId  String
  gameId    String?
  actorId   String?
  payload   Json
  createdAt DateTime      @default(now())

  @@index([createdAt])
  @@index([studioId])
  @@index([gameId])
  @@index([type, createdAt])
  @@map("feed_events")
}

model RoadmapItem {
  id          String        @id @default(cuid())
  gameId      String
  title       String
  description String?
  status      RoadmapStatus @default(PLANNED)
  targetDate  DateTime?
  position    Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
  @@map("roadmap_items")
}

// ──────────────────────────────────────────────────────────────────────────
// Community: follows, comments, reactions
// ──────────────────────────────────────────────────────────────────────────

model Follow {
  id         String           @id @default(cuid())
  userId     String
  targetType FollowTargetType
  /// Exactly one of studioId / gameId is set, matching targetType.
  studioId   String?
  gameId     String?
  createdAt  DateTime         @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  studio Studio? @relation(fields: [studioId], references: [id], onDelete: Cascade)
  game   Game?   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  // Postgres treats NULLs as distinct, so each pair enforces one follow per
  // target without blocking follows of the other kind.
  @@unique([userId, studioId])
  @@unique([userId, gameId])
  @@index([userId, targetType])
  @@index([studioId])
  @@index([gameId])
  @@map("follows")
}

model Comment {
  id        String    @id @default(cuid())
  devlogId  String?
  gameId    String?
  authorId  String
  body      String
  type      String    @default("REPLY")
  /// Self-relation for threaded replies.
  parentId  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  devlog    Devlog?    @relation(fields: [devlogId], references: [id], onDelete: Cascade)
  game      Game?      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    Comment?   @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]  @relation("CommentReplies")
  reactions Reaction[]

  @@index([devlogId])
  @@index([gameId])
  @@index([authorId])
  @@index([parentId])
  @@map("comments")
}

model Reaction {
  id        String       @id @default(cuid())
  userId    String
  type      ReactionType @default(LIKE)
  devlogId  String?
  commentId String?
  createdAt DateTime     @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  devlog  Devlog?  @relation(fields: [devlogId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, devlogId, type])
  @@unique([userId, commentId, type])
  @@index([devlogId])
  @@index([commentId])
  @@index([userId])
  @@map("reactions")
}

// ──────────────────────────────────────────────────────────────────────────
// Tagging
// ──────────────────────────────────────────────────────────────────────────

model Tag {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  /// Grouping for the tag, e.g. "genre" | "feature" | "mood" | "platform".
  kind      String?
  createdAt DateTime  @default(now())

  games GameTag[]

  @@map("tags")
}

model GameTag {
  gameId String
  tagId  String

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([gameId, tagId])
  @@index([tagId])
  @@map("game_tags")
}

// ──────────────────────────────────────────────────────────────────────────
// Moderation
// ──────────────────────────────────────────────────────────────────────────

model ModerationReport {
  id           String           @id @default(cuid())
  reporterId   String
  targetType   ReportTargetType
  /// ID of the reported entity (polymorphic; resolved in app logic).
  targetId       String
  reason         ReportReason
  details        String?
  status         ReportStatus   @default(OPEN)
  escalatedAt    DateTime?
  resolutionNote String?
  resolvedById   String?
  resolvedAt     DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  reporter   User  @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy User? @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([targetType, targetId])
  @@index([reporterId])
  @@map("moderation_reports")
}

// ──────────────────────────────────────────────────────────────────────────
// Notifications
// ──────────────────────────────────────────────────────────────────────────

enum NotificationType {
  WELCOME
  NEW_FOLLOWER
  NEW_COMMENT
  NEW_REPLY
  NEW_REACTION
  STUDIO_INVITATION
  INVITATION_ACCEPTED
  MEMBER_JOINED
  MEMBER_LEFT
  ROLE_CHANGED
  MEMBER_REMOVED
  JOIN_REQUEST
}

enum NotificationTargetType {
  STUDIO
  GAME
  DEVLOG
  COMMENT
}

model Notification {
  id          String               @id @default(cuid())
  recipientId String
  actorId     String?
  type        NotificationType
  title       String
  body        String?
  targetType  NotificationTargetType?
  targetId    String?
  readAt      DateTime?
  createdAt   DateTime             @default(now())

  recipient User  @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([recipientId, createdAt])
  @@index([recipientId, readAt, createdAt])
  @@index([targetType, targetId])
  @@map("notifications")
}

// ──────────────────────────────────────────────────────────────────────────
// Refresh tokens (#2)
// ──────────────────────────────────────────────────────────────────────────

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ──────────────────────────────────────────────────────────────────────────
// Server-side sessions (opaque, httpOnly cookie)
// ──────────────────────────────────────────────────────────────────────────

model Session {
  id           String    @id @default(cuid())
  sessionHash  String    @unique
  userId       String
  createdAt    DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  ipHash       String?
  userAgent    String?
  authVersion  Int       @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ──────────────────────────────────────────────────────────────────────────
// Email verification & password reset tokens
// ──────────────────────────────────────────────────────────────────────────

model VerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
  consumedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("verification_tokens")
}

model EmailVerificationCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("email_verification_codes")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
  consumedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ──────────────────────────────────────────────────────────────────────────
// Activity Timeline — centralized event log
// ──────────────────────────────────────────────────────────────────────────

model ActivityEvent {
  id        String   @id @default(cuid())
  eventType String
  actorId   String?
  targetId  String?
  targetType String?
  studioId  String?
  gameId    String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([studioId, createdAt])
  @@index([gameId, createdAt])
  @@index([eventType, createdAt])
  @@index([createdAt])
  @@map("activity_events")
}

// ──────────────────────────────────────────────────────────────────────────
// Studio Goals — auto-tracked milestones
// ──────────────────────────────────────────────────────────────────────────

model StudioGoal {
  id          String   @id @default(cuid())
  studioId    String
  goalId      String
  title       String
  description String?
  category    String
  requirement Int
  progress    Int      @default(0)
  isCompleted Boolean  @default(false)
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@unique([studioId, goalId])
  @@index([studioId, isCompleted])
  @@map("studio_goals")
}

// ──────────────────────────────────────────────────────────────────────────
// Studio Achievements
// ──────────────────────────────────────────────────────────────────────────

model StudioAchievement {
  id             String   @id @default(cuid())
  studioId       String
  achievementId  String
  title          String
  description    String?
  icon           String?
  unlockedAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@unique([studioId, achievementId])
  @@index([studioId])
  @@map("studio_achievements")
}

// ──────────────────────────────────────────────────────────────────────────
// Studio Health Score snapshots
// ──────────────────────────────────────────────────────────────────────────

model StudioHealthScore {
  id          String   @id @default(cuid())
  studioId    String
  score       Int
  level       String   // EXCELLENT | GOOD | NEEDS_ATTENTION | INCOMPLETE
  breakdown   Json?    // per-category scores
  recommendations Json?
  calculatedAt DateTime @default(now())

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([studioId, calculatedAt])
  @@map("studio_health_scores")
}

// ──────────────────────────────────────────────────────────────────────────
// Weekly Reports
// ──────────────────────────────────────────────────────────────────────────

model StudioWeeklyReport {
  id          String   @id @default(cuid())
  studioId    String
  weekStart   DateTime
  weekEnd     DateTime
  data        Json     // full report data
  isDelivered Boolean  @default(false)
  deliveredAt DateTime?
  createdAt   DateTime @default(now())

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([studioId, weekStart])
  @@map("studio_weekly_reports")
}

// ──────────────────────────────────────────────────────────────────────────
// Analytics — event tracking, aggregations, studio metrics
// ──────────────────────────────────────────────────────────────────────────

model AnalyticsEvent {
  id          String   @id @default(cuid())
  eventType   String
  gameId      String?
  studioId    String?
  userId      String?
  sessionId   String?
  metadata    Json?
  ip          String?
  country     String?
  referrer    String?
  userAgent   String?
  locale      String?
  timestamp   DateTime @default(now())

  @@index([eventType])
  @@index([gameId, eventType, timestamp])
  @@index([studioId, eventType, timestamp])
  @@index([timestamp])
  @@index([gameId, timestamp])
  @@index([studioId, timestamp])
  @@map("analytics_events")
}

model AnalyticsDailyAggregate {
  id        String   @id @default(cuid())
  date      DateTime
  gameId    String?
  studioId  String?
  eventType String
  count     Int      @default(0)
  uniqueCount Int    @default(0)
  updatedAt DateTime @updatedAt

  @@unique([date, gameId, studioId, eventType])
  @@index([gameId, date])
  @@index([studioId, date])
  @@index([eventType, date])
  @@map("analytics_daily_aggregates")
}

// ──────────────────────────────────────────────────────────────────────────
// Help Center — articles, categories, feedback, guides
// ──────────────────────────────────────────────────────────────────────────

model HelpCategory {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  icon        String?
  position    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  articles HelpArticle[]

  @@index([position])
  @@map("help_categories")
}

model HelpArticle {
  id            String      @id @default(cuid())
  slug          String      @unique
  title         String
  description   String?
  body          String      @db.Text
  categoryId    String?
  tags          String[]
  authorId      String
  isPublished   Boolean     @default(false)
  isFeatured    Boolean     @default(false)
  publishedAt   DateTime?
  readingTimeMin Int?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  category HelpCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author    User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  feedback  HelpArticleFeedback[]

  @@index([categoryId])
  @@index([authorId])
  @@index([isPublished])
  @@index([isFeatured])
  @@index([publishedAt])
  @@map("help_articles")
}

model HelpArticleFeedback {
  id        String   @id @default(cuid())
  articleId String
  userId    String
  helpful   Boolean
  comment   String?
  createdAt DateTime @default(now())

  article HelpArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([articleId, userId])
  @@map("help_article_feedback")
}

// ──────────────────────────────────────────────────────────────────────────
// Support Ecosystem — tickets, replies, categories, attachments, history
// ──────────────────────────────────────────────────────────────────────────

enum SupportTicketStatus {
  OPEN
  WAITING_SUPPORT
  WAITING_CUSTOMER
  INVESTIGATING
  ESCALATED
  RESOLVED
  CLOSED
  ARCHIVED
  SPAM
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
  SECURITY
  EMERGENCY
}

enum SupportDepartment {
  GENERAL
  TECHNICAL
  ACCOUNTS
  STUDIO
  PUBLISHING
  MODERATION
  COMMUNITY
  BUG_REPORT
  FEATURE_REQUEST
  DMCA
  COPYRIGHT
  LEGAL
  SECURITY
}

model SupportCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  department  SupportDepartment @default(GENERAL)
  position    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tickets SupportTicket[]

  @@map("support_categories")
}

model SupportTicket {
  id             String                 @id @default(cuid())
  ticketNumber   String                 @unique
  title          String
  body           String                 @db.Text
  status         SupportTicketStatus    @default(OPEN)
  priority       SupportTicketPriority  @default(MEDIUM)
  department     SupportDepartment      @default(GENERAL)
  categoryId     String?
  authorId       String
  assignedToId   String?
  assignedAt     DateTime?
  resolvedAt     DateTime?
  closedAt       DateTime?
  reopenedAt     DateTime?
  isInternal     Boolean                @default(false)
  metadata       Json?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  author      User               @relation("SupportTicketsAuthored", fields: [authorId], references: [id], onDelete: Cascade)
  assignedTo  User?              @relation("SupportTicketsAssigned", fields: [assignedToId], references: [id], onDelete: SetNull)
  category    SupportCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  replies     SupportReply[]
  attachments SupportAttachment[]
  history     SupportTicketHistory[]

  @@index([authorId])
  @@index([assignedToId])
  @@index([status])
  @@index([priority])
  @@index([department])
  @@index([createdAt])
  @@index([ticketNumber])
  @@map("support_tickets")
}

model SupportReply {
  id         String   @id @default(cuid())
  ticketId   String
  authorId   String
  body       String   @db.Text
  isInternal Boolean  @default(false)
  isStaff    Boolean  @default(false)
  editedAt   DateTime?
  createdAt  DateTime @default(now())

  ticket      SupportTicket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author      User                  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  attachments SupportAttachment[]

  @@index([ticketId])
  @@index([authorId])
  @@index([createdAt])
  @@map("support_replies")
}

model SupportAttachment {
  id          String @id @default(cuid())
  ticketId    String?
  replyId     String?
  filename    String
  originalName String
  mimeType    String
  size        Int
  url         String
  createdAt   DateTime @default(now())

  ticket SupportTicket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  reply  SupportReply?  @relation(fields: [replyId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([replyId])
  @@map("support_attachments")
}

model SupportTicketHistory {
  id        String   @id @default(cuid())
  ticketId  String
  actorId   String
  action    String
  fromValue String?
  toValue   String?
  metadata  Json?
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor  User          @relation("SupportHistoryActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([actorId])
  @@index([createdAt])
  @@map("support_ticket_history")
}

// ──────────────────────────────────────────────────────────────────────────
// Wishlist — private game saves (not public follows)
// ──────────────────────────────────────────────────────────────────────────

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  gameId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([userId])
  @@index([userId, createdAt])
  @@index([gameId])
  @@map("wishlist_items")
}

model EmailTemplate {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  subject   String
  bodyHtml  String
  variables String[]
  category  String   @default("transactional")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("email_templates")
}

model EmailLog {
  id         String   @id @default(cuid())
  userId     String?
  email      String
  templateId String?
  status     String   @default("pending")
  error      String?
  openedAt   DateTime?
  clickedAt  DateTime?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([status])
  @@map("email_logs")
}

model EmailPreference {
  id                   String   @id @default(cuid())
  userId               String   @unique
  marketingOptIn       Boolean  @default(false)
  digestFrequency      String   @default("weekly")
  devlogNotifications  Boolean  @default(true)
  wishlistNotifications Boolean @default(true)
  releaseNotifications  Boolean @default(true)
  followNotifications  Boolean @default(true)
  unsubscribeToken     String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_preferences")
}

model ApiKey {
  id        String   @id @default(cuid())
  userId    String
  name      String
  keyHash   String   @unique
  keyPrefix String
  scopes    String[] @default([])
  lastUsedAt DateTime?
  expiresAt DateTime?
  createdAt DateTime @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([keyHash])
  @@index([userId])
  @@map("api_keys")
}

model GameView {
  id        String   @id @default(cuid())
  gameId    String
  createdAt DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
  @@index([gameId, createdAt])
  @@map("game_views")
}
